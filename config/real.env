# Physical A1Z + wrist-mounted Intel RealSense D405. Select explicitly with
# A1Z_PROFILE=real; no launcher chooses this profile implicitly.
A1Z_BACKEND=socketcan
A1Z_CAMERA_SOURCE=realsense
A1Z_TCP_PORT=37104
# Keep target selection and AnyGrasp on the proven remote NVIDIA host. These
# are deployment coordinates only; SSH credentials remain outside the repo.
A1Z_REAL_VISION_BACKEND=remote_ssh
A1Z_REMOTE_GPU_HOST=10.66.0.11
A1Z_REMOTE_GPU_USER=th1rt3en
A1Z_REMOTE_GPU_PORT=22
A1Z_REMOTE_GPU_ROOT=/home/th1rt3en/dev/forge/A1Z
A1Z_REMOTE_GPU_IDENTITY_FILE=
A1Z_REMOTE_GPU_TIMEOUT_S=900
A1Z_REMOTE_GPU_CONNECT_TIMEOUT_S=10
A1Z_REMOTE_GPU_STRICT_HOST_KEY_CHECKING=accept-new
A1Z_CAMERA_BRIDGE_HOST=127.0.0.1
A1Z_CAMERA_BRIDGE_PORT=37204
A1Z_ROS2_CONTAINER_NAME=a1z-ros2-humble-real
A1Z_RVIZ_CONTAINER_NAME=a1z-rviz-humble-real
A1Z_CAN_CHANNEL=can0
# The control-service manager applies this bitrate and brings SocketCAN UP
# automatically before it starts the real robot backend.
A1Z_CAN_BITRATE=1000000
A1Z_CONTROL_FREQ_HZ=250
A1Z_MIN_CONTROL_FREQ_HZ=80
A1Z_GRIPPER_MAX_TORQUE=0.5
A1Z_GRIPPER_EMPTY_CLOSE_THRESHOLD=0.04
A1Z_D405_SERIAL_NO=
A1Z_REALSENSE_CAMERA_NAME=d405
A1Z_REALSENSE_BASE_FRAME_ID=link
A1Z_REALSENSE_INITIAL_RESET=0
# Suppress unthrottled librealsense ERROR output after a USB disconnect. Camera
# freshness remains observable through the profile-isolated camera bridge.
LRS_LOG_LEVEL=fatal
A1Z_REALSENSE_MIN_USB_SPEED_MBPS=5000
A1Z_D405_WIDTH=640
A1Z_D405_HEIGHT=480
A1Z_D405_FPS=30
A1Z_CAMERA_PREVIEW_DEPTH_MIN_M=0.07
A1Z_CAMERA_PREVIEW_DEPTH_MAX_M=1.00
A1Z_RGBD_DEPTH_TOPIC=/a1z/d405/aligned_depth_to_color/image_raw
A1Z_RGBD_DEPTH_INFO_TOPIC=/a1z/d405/aligned_depth_to_color/camera_info
