# Shared task-layer contract. This file never selects a robot or camera backend.
ROS_DOMAIN_ID=62
A1Z_ROS2_BASE_IMAGE_TAG=a1z-ros2-humble-base:local
A1Z_ROS2_IMAGE_TAG=a1z-ros2-humble:local
A1Z_SDK_DIR=/workspace/A1Z/vendor/GALAXEA-A1Z
A1Z_CONTROL_URDF=/workspace/A1Z/build/robot_packages/A1Z_G1Z/urdf/A1Z_G1Z_control.urdf
A1Z_SOCKET_PATH=
A1Z_TCP_HOST=127.0.0.1
A1Z_TCP_PORT=37103
A1Z_WITH_GRIPPER=1
A1Z_BASE_LINK_FRAME=base_link
A1Z_ROBOT_BASE_FRAME=robot_base_frame
A1Z_TOOL_LINK_FRAME=grasp_tcp
A1Z_TOOL_FRAME=grasp_tcp
A1Z_D405_LINK_FRAME=d405_link
A1Z_D405_RECTIFIED_FRAME_ID=d405_rectified_link
A1Z_D405_COLOR_FRAME_ID=d405_color_optical_frame
A1Z_D405_DEPTH_FRAME_ID=d405_depth_optical_frame
A1Z_RGBD_TARGET_FRAME=base_link
A1Z_RGBD_COLOR_TOPIC=/a1z/d405/color/image_raw
A1Z_RGBD_COLOR_INFO_TOPIC=/a1z/d405/color/camera_info
A1Z_EXEC_ARM_SPEED=0.5
A1Z_TABLE_HEIGHT_M=0.0

# GPU vision runtime (VLM/SAM/AnyGrasp).
A1Z_VISION_CONTAINER_NAME=a1z-vision-gpu
A1Z_VISION_IMAGE_TAG=a1z-vision-gpu:local
A1Z_VISION_BASE_IMAGE=docker.m.daocloud.io/nvidia/cuda:12.8.1-devel-ubuntu22.04
A1Z_VISION_VENV_DIR=/opt/venvs/a1z-vision
A1Z_VISION_MODEL_ROOT=/workspace/A1Z/runtime/models
A1Z_SAM2_REPO_DIR=/workspace/A1Z/vendor/vision/sam2
A1Z_SAM3_REPO_DIR=/workspace/A1Z/vendor/vision/sam3
A1Z_ANYGRASP_SDK_DIR=/workspace/A1Z/vendor/vision/anygrasp_sdk
A1Z_SAM2_DEFAULT_VARIANT=sam2.1_hiera_small
A1Z_SAM2_DEFAULT_CKPT=/workspace/A1Z/runtime/models/sam2/sam2.1_hiera_small.pt
A1Z_ANYGRASP_DETECTION_CKPT=/workspace/A1Z/runtime/models/anygrasp/checkpoint_detection.tar
A1Z_ANYGRASP_TRACKING_CKPT=/workspace/A1Z/runtime/models/anygrasp/checkpoint_tracking.tar
A1Z_ANYGRASP_LICENSE_DIR=/workspace/A1Z/runtime/licenses/anygrasp
A1Z_ANYGRASP_IFCONFIG_SNAPSHOT=/workspace/A1Z/runtime/anygrasp/ifconfig.snapshot
A1Z_ANYGRASP_REFRESH_FINGERPRINT_SNAPSHOT=0
A1Z_ANYGRASP_BINDING_LABEL=opening=c1,height=c2,approach=c0
A1Z_ANYGRASP_CAMERA_CORRECTION_LABEL=identity
A1Z_ANYGRASP_EXTRINSIC_CORRECTION_LABEL=identity
A1Z_ANYGRASP_EE_GRASP_ORIGIN=[0.0, 0.0, 0.0]
A1Z_ANYGRASP_EE_OPENING_AXIS=[0.0, 1.0, 0.0]
A1Z_ANYGRASP_EE_APPROACH_AXIS=[1.0, 0.0, 0.0]
