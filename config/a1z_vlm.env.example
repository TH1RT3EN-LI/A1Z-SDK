# Copy to config/a1z_vlm.env and fill in local secrets.
# Keep config/a1z_vlm.env out of git.

# GPT / OpenAI-compatible
OPENAI_API_KEY=

# Kimi / Moonshot-compatible
MOONSHOT_API_KEY=

# Optional defaults for non-ROS Python scripts that call LLMProviderConfig.from_env().
A1Z_VLM_PROVIDER=kimi
A1Z_VLM_MODEL=
A1Z_VLM_BASE_URL=
A1Z_VLM_API_KEY_ENV=MOONSHOT_API_KEY
A1Z_VLM_TIMEOUT_S=30.0
A1Z_VLM_MAX_TOKENS=512
A1Z_VLM_TEMPERATURE=0.0
