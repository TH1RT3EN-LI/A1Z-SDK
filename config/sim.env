# Isaac Sim device adapters. Select with A1Z_PROFILE=sim.
A1Z_BACKEND=isaacsim
A1Z_CAMERA_SOURCE=isaac
A1Z_TCP_PORT=37103
A1Z_CONTROL_FREQ_HZ=60
A1Z_ROS2_CONTAINER_NAME=a1z-ros2-humble-sim
A1Z_RVIZ_CONTAINER_NAME=a1z-rviz-humble-sim
ISAAC_SIM_CONTAINER_NAME=a1z-isaac-sim-6-0-1
A1Z_ISAAC_LAUNCH_MODE=native
A1Z_CAN_CHANNEL=can0
A1Z_WORLD_USD=/workspace/A1Z/build/scenes/A1Z_G1Z_world.usd
A1Z_ISAAC_ARTICULATION_ROOT=/World/A1Z_G1Z/Geometry
A1Z_ISAAC_ASSET_GEOMETRY_ROOT=/World/A1Z_G1Z/Geometry
A1Z_ISAAC_CONTROL_FREQ_HZ=60
A1Z_ISAAC_API_PROFILE=native_6_0
A1Z_ISAAC_MIRROR_DRIVE_TARGETS_TO_USD=0
A1Z_D405_ENABLED=1
A1Z_D405_PARENT_PRIM=/World/A1Z_G1Z/Geometry
A1Z_D405_FK_FRAME=arm_link6
A1Z_D405_COLLISION_ENABLED=0
A1Z_GRIPPER_FINGER_MASS_KG=0.02
A1Z_D405_CAMERA_PRIMS_ENABLED=1
A1Z_D405_CENTER_MESH_Y=1
A1Z_D405_CENTER_ON_AXIS=1
A1Z_D405_STATUS_PATH=/workspace/A1Z/runtime/logs/d405-link-camera.status
A1Z_D405_ROS2_NAMESPACE=/a1z/d405
A1Z_D405_WIDTH=320
A1Z_D405_HEIGHT=240
A1Z_D405_CAPTURE_HZ=10
A1Z_D405_ROS_POLL_HZ=10.0
A1Z_D405_ANNOTATOR_DEVICE=cuda
A1Z_D405_ZLIB_LEVEL=1
A1Z_D405_ENCODE_WORKERS=2
A1Z_D405_FRAME_SKIP_COUNT=1
A1Z_RGBD_DEPTH_TOPIC=/a1z/d405/depth/image_rect
A1Z_RGBD_DEPTH_INFO_TOPIC=/a1z/d405/depth/camera_info
