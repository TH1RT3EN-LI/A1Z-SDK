# Isaac Sim 6.0.1 standalone A1Z deployment.
ROS_DOMAIN_ID=62
A1Z_BACKEND=isaacsim
A1Z_TCP_HOST=127.0.0.1
A1Z_TCP_PORT=37103
A1Z_SOCKET_PATH=
A1Z_ISAAC_CONTROL_FREQ_HZ=60
A1Z_ISAAC_API_PROFILE=native_6_0
A1Z_ISAAC_ARTICULATION_ROOT=/World/A1Z_G1Z/Geometry
A1Z_ISAAC_ASSET_GEOMETRY_ROOT=/World/A1Z_G1Z/Geometry
A1Z_ISAAC_MIRROR_DRIVE_TARGETS_TO_USD=0
A1Z_D405_PARENT_PRIM=/World/A1Z_G1Z/Geometry
A1Z_D405_FALLBACK_PARENT_PRIM=
A1Z_D405_WIDTH=320
A1Z_D405_HEIGHT=240
A1Z_D405_CAPTURE_HZ=10
A1Z_D405_ROS_POLL_HZ=10.0
A1Z_D405_ANNOTATOR_DEVICE=cuda
A1Z_D405_ZLIB_LEVEL=1
A1Z_D405_ENCODE_WORKERS=2
A1Z_ANYGRASP_GRASP_MODE=physical_v2
A1Z_PHYSICAL_GRASP_CONTROLLER_PROFILE=/workspace/A1Z/config/grasping/controllers/a1z_physical_gripper_v1.json
