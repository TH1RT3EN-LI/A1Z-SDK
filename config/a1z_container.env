# Host-side defaults for A1Z container helpers.
# The Isaac Sim image is shared, but these defaults are for this workspace's
# project-scoped container instance and mounted assets.
ISAAC_SIM_CONTAINER_NAME=isaac-sim-5-1-dev
A1Z_SDK_VENV_DIR=/home/ubuntu/.venvs/a1z-sdk
A1Z_SDK_DIR=/workspace/A1Z/vendor/GALAXEA-A1Z
A1Z_SERVER_IP=10.66.0.11
# Default backend for generic SDK helper commands. The headless Isaac streaming
# launcher ignores this value and always starts the in-process Isaac backend.
A1Z_BACKEND=socketcan
A1Z_CAN_CHANNEL=can0
A1Z_SOCKET_PATH=/tmp/a1z.sock
A1Z_TCP_HOST=0.0.0.0
A1Z_TCP_PORT=18080
A1Z_WORLD_USD=/workspace/A1Z/build/scenes/A1Z_G1Z_world.usd
A1Z_CONTROL_URDF=/workspace/A1Z/build/robot_packages/A1Z_G1Z/urdf/A1Z_G1Z_control.urdf
A1Z_WITH_GRIPPER=1
A1Z_EE_DRAG_TARGET_ENABLED=0
A1Z_ISAAC_ARTICULATION_ROOT=/World/A1Z_G1Z/Geometry
A1Z_ISAAC_CONTROL_FREQ_HZ=60
A1Z_D405_ENABLED=1
A1Z_D405_PARENT_PRIM=/World/A1Z_G1Z/Geometry
A1Z_D405_FALLBACK_PARENT_PRIM=/World
A1Z_D405_FK_FRAME=arm_link6
# Stage-only D405 mechanical install relative to arm_link6, in meters: x,y,z.
A1Z_D405_STAGE_MOUNT_OFFSET_XYZ_M=0.08,0,0.08623718
# Stage-only D405 mechanical install rotation relative to arm_link6, in degrees: roll(X),pitch(Y),yaw(Z).
# Current semantic split keeps only the physical install here and moves "upright"/optical semantics
# into the stage rectified/optical chain below.
A1Z_D405_STAGE_MOUNT_RPY_DEG=0,0,0
# Keep d405_link aligned with arm_link6; no rotation is authored in the link chain.
A1Z_D405_STAGE_RECTIFY_RPY_DEG=0,0,0
# Visual-only calibration: this is the D405 mesh rotation expressed in standard URDF RPY,
# equivalent to applying fixed-axis rotations on the mesh's initial axes:
# first Z +90deg, then Y +129deg.
A1Z_D405_BODY_VISUAL_RPY_DEG=129,0,90
# Generate D405 wrist camera geometry into URDF/USD.
A1Z_D405_COLLISION_ENABLED=0
# Residual transform from the rectified D405 frame to the ROS optical frame.
# Keep translation zero; the optical axis rotation is fixed by the shared
# semantic chain. This entry is stage-only.
A1Z_D405_STAGE_RECTIFIED_TO_OPTICAL_OFFSET_XYZ_M=0,0,0
A1Z_D405_STAGE_RECTIFIED_TO_OPTICAL_RPY_DEG=51,0,-90
# Compute-side D405 chain for ROS/AnyGrasp/extrinsic.
A1Z_D405_COMPUTE_INSTALL_RPY_DEG=0,39,0
A1Z_D405_COMPUTE_RECTIFY_RPY_DEG=0,0,0
A1Z_D405_COMPUTE_RECTIFIED_TO_OPTICAL_OFFSET_XYZ_M=0,0,0
# D405 inertial mass used in generated URDF/USD. Keep non-zero for stable physics.
A1Z_D405_MASS_KG=0.001
A1Z_D405_CAMERA_PRIMS_ENABLED=1
A1Z_D405_CENTER_MESH_Y=1
A1Z_D405_CENTER_ON_AXIS=1
A1Z_D405_STATUS_PATH=/workspace/A1Z/runtime/logs/d405-link-camera.status
A1Z_D405_ROS2_NAMESPACE=/a1z/d405
A1Z_D405_RECTIFIED_FRAME_ID=d405_rectified_link
A1Z_D405_COLOR_FRAME_ID=d405_color_optical_frame
A1Z_D405_DEPTH_FRAME_ID=d405_depth_optical_frame
A1Z_D405_WIDTH=1280
A1Z_D405_HEIGHT=720
A1Z_D405_FRAME_SKIP_COUNT=1

# Dedicated GPU vision runtime for SAM / AnyGrasp.
A1Z_VISION_CONTAINER_NAME=a1z-vision-gpu
A1Z_VISION_IMAGE_TAG=a1z-vision-gpu:local
A1Z_VISION_BASE_IMAGE=docker.m.daocloud.io/nvidia/cuda:12.8.1-devel-ubuntu22.04
A1Z_VISION_VENV_DIR=/opt/venvs/a1z-vision
A1Z_VISION_MODEL_ROOT=/workspace/A1Z/runtime/models
A1Z_SAM2_REPO_DIR=/workspace/A1Z/vendor/vision/sam2
A1Z_SAM3_REPO_DIR=/workspace/A1Z/vendor/vision/sam3
A1Z_ANYGRASP_SDK_DIR=/workspace/A1Z/vendor/vision/anygrasp_sdk
A1Z_SAM2_DEFAULT_VARIANT=sam2.1_hiera_small
A1Z_SAM2_DEFAULT_CKPT=/workspace/A1Z/runtime/models/sam2/sam2.1_hiera_small.pt
A1Z_ANYGRASP_DETECTION_CKPT=/workspace/A1Z/runtime/models/anygrasp/checkpoint_detection.tar
A1Z_ANYGRASP_TRACKING_CKPT=/workspace/A1Z/runtime/models/anygrasp/checkpoint_tracking.tar
A1Z_ANYGRASP_LICENSE_DIR=/workspace/A1Z/runtime/licenses/anygrasp
A1Z_ANYGRASP_IFCONFIG_SNAPSHOT=/workspace/A1Z/runtime/anygrasp/ifconfig.snapshot
A1Z_ANYGRASP_REFRESH_FINGERPRINT_SNAPSHOT=0
A1Z_ANYGRASP_BINDING_LABEL=opening=c1,height=c2,approach=c0
A1Z_ANYGRASP_CAMERA_CORRECTION_LABEL=identity
A1Z_ANYGRASP_EXTRINSIC_CORRECTION_LABEL=identity
A1Z_ANYGRASP_EXECUTION_MODE=best_direct
A1Z_ANYGRASP_EE_GRASP_ORIGIN=[0.0, 0.0, 0.0]
A1Z_ANYGRASP_EE_OPENING_AXIS=[0.0, 0.0, 1.0]
A1Z_ANYGRASP_EE_APPROACH_AXIS=[1.0, 0.0, 0.0]
A1Z_EE_FRAME=grasp_tcp
A1Z_TOOL_LINK_FRAME=grasp_tcp
A1Z_TOOL_FRAME=grasp_tcp
