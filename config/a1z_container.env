# Host-side defaults for A1Z container helpers.
# The Isaac Sim image is shared, but these defaults are for this workspace's
# project-scoped container instance and mounted assets.
ISAAC_SIM_CONTAINER_NAME=isaac-sim-5-1-dev
A1Z_SDK_VENV_DIR=/home/ubuntu/.venvs/a1z-sdk
A1Z_SDK_DIR=/workspace/A1Z/vendor/GALAXEA-A1Z
A1Z_SERVER_IP=10.66.0.11
# Default backend for generic SDK helper commands. The headless Isaac streaming
# launcher ignores this value and always starts the in-process Isaac backend.
A1Z_BACKEND=socketcan
A1Z_CAN_CHANNEL=can0
A1Z_SOCKET_PATH=/tmp/a1z.sock
A1Z_TCP_HOST=0.0.0.0
A1Z_TCP_PORT=18080
A1Z_WORLD_USD=/workspace/A1Z/build/scenes/A1Z_G1Z_world.usd
A1Z_CONTROL_URDF=/workspace/A1Z/build/robot_packages/A1Z_G1Z/urdf/A1Z_G1Z_control.urdf
A1Z_WITH_GRIPPER=1
A1Z_ISAAC_ARTICULATION_ROOT=/World/A1Z_G1Z/Geometry
A1Z_ISAAC_CONTROL_FREQ_HZ=60
A1Z_D405_ENABLED=1
A1Z_D405_PARENT_PRIM=/World
A1Z_D405_FALLBACK_PARENT_PRIM=/World
A1Z_D405_FK_FRAME=arm_link6
# D405 mount translation relative to arm_link6, in meters: x,y,z
A1Z_D405_MOUNT_OFFSET=0.08,0,0.08623718
# D405 mount rotation relative to arm_link6, in degrees: roll(X),pitch(Y),yaw(Z)
A1Z_D405_MOUNT_RPY_DEG=129,0,90
A1Z_D405_CAMERA_OPTICAL_RPY_DEG=0,180,0
# D405 inertial mass used in generated URDF/USD. Keep non-zero for stable physics.
A1Z_D405_MASS_KG=0.001
A1Z_D405_CAMERA_PRIMS_ENABLED=1
A1Z_D405_CENTER_MESH_Y=1
A1Z_D405_CENTER_ON_AXIS=1
A1Z_D405_STATUS_PATH=/workspace/A1Z/runtime/logs/d405-wrist-camera.status
A1Z_D405_ROS2_NAMESPACE=/a1z/d405
A1Z_D405_COLOR_FRAME_ID=d405_color_optical_frame
A1Z_D405_DEPTH_FRAME_ID=d405_depth_optical_frame
A1Z_D405_WIDTH=1280
A1Z_D405_HEIGHT=720
A1Z_D405_FRAME_SKIP_COUNT=1

# Dedicated GPU vision runtime for SAM / AnyGrasp.
A1Z_VISION_CONTAINER_NAME=a1z-vision-gpu
A1Z_VISION_IMAGE_TAG=a1z-vision-gpu:local
A1Z_VISION_VENV_DIR=/opt/venvs/a1z-vision
A1Z_VISION_MODEL_ROOT=/workspace/A1Z/runtime/models
A1Z_SAM2_REPO_DIR=/workspace/A1Z/vendor/vision/sam2
A1Z_SAM3_REPO_DIR=/workspace/A1Z/vendor/vision/sam3
A1Z_ANYGRASP_SDK_DIR=/workspace/A1Z/vendor/vision/anygrasp_sdk
A1Z_SAM2_DEFAULT_VARIANT=sam2.1_hiera_small
A1Z_SAM2_DEFAULT_CKPT=/workspace/A1Z/runtime/models/sam2/sam2.1_hiera_small.pt
A1Z_ANYGRASP_DETECTION_CKPT=/workspace/A1Z/runtime/models/anygrasp/checkpoint_detection.tar
A1Z_ANYGRASP_TRACKING_CKPT=/workspace/A1Z/runtime/models/anygrasp/checkpoint_tracking.tar
A1Z_ANYGRASP_LICENSE_DIR=/workspace/A1Z/runtime/licenses/anygrasp
