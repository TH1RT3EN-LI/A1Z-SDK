#!/usr/bin/env python3
"""a1zctl — CLI client for the A1Z robot arm server.

Start the server first, then send commands from any terminal (including OpenClaw).

Usage
-----
  # Terminal 1 — keep running:
  python3 tools/a1zctl serve [--backend socketcan|mock|isaacsim] [--can can0] [--with-gripper] [--gravity-mode]

  # Terminal 2 (or OpenClaw):
  python3 tools/a1zctl status
  python3 tools/a1zctl move 0,60,-60,0,0,0
  python3 tools/a1zctl command 0,60,-60,0,0,0 --gripper 0.5
  python3 tools/a1zctl move --preset home
  python3 tools/a1zctl gripper 0.5
  python3 tools/a1zctl dance --moves salute,wave,bow
  python3 tools/a1zctl info
  python3 tools/a1zctl stop
"""

import argparse
import json
import os
import socket
import sys

# Allow running from any directory without installing the package.
REPO_ROOT = os.path.join(os.path.dirname(os.path.abspath(__file__)), "..")
SDK_ROOT = os.path.join(REPO_ROOT, "vendor", "GALAXEA-A1Z")
sys.path.insert(0, REPO_ROOT)
sys.path.insert(0, SDK_ROOT)

from a1z_ext.config import (
    get_default_backend,
    get_default_can_channel,
    get_socket_path,
    get_tcp_host,
    get_tcp_port,
)  # noqa: E402


# ---------------------------------------------------------------------------
# Socket helpers
# ---------------------------------------------------------------------------

def _send(cmd: str, args: dict | None = None) -> dict:
    """Send one command to the server and return the parsed response."""
    req = json.dumps({"cmd": cmd, "args": args or {}}) + "\n"
    socket_path = get_socket_path()
    try:
        sock = socket.socket(socket.AF_UNIX, socket.SOCK_STREAM)
        sock.settimeout(120.0)
        sock.connect(socket_path)
        sock.sendall(req.encode())
        data = b""
        while b"\n" not in data:
            chunk = sock.recv(4096)
            if not chunk:
                break
            data += chunk
        sock.close()
        return json.loads(data.split(b"\n", 1)[0].decode())
    except FileNotFoundError:
        print(f"[a1zctl] Socket not found: {get_socket_path()}")
        print("[a1zctl] Start the server first:  python3 tools/a1zctl serve")
        sys.exit(1)
    except ConnectionRefusedError:
        print("[a1zctl] Server not running.  Start with:  python3 tools/a1zctl serve")
        sys.exit(1)


def _ok_or_exit(resp: dict) -> dict:
    if not resp.get("ok"):
        print(f"[a1zctl] Error: {resp.get('error', 'unknown error')}")
        sys.exit(1)
    return resp.get("data", {})


def _emit(args: argparse.Namespace, data: dict) -> None:
    if args.json:
        print(json.dumps(data))


# ---------------------------------------------------------------------------
# Sub-command implementations
# ---------------------------------------------------------------------------

def cmd_serve(args: argparse.Namespace) -> None:
    from a1z_ext.robots.server import serve

    serve(
        backend=args.backend,
        can_channel=args.can,
        with_gripper=args.with_gripper,
        gravity_mode=args.gravity_mode,
        socket_path=args.socket_path,
        tcp_host=args.tcp_host,
        tcp_port=args.tcp_port,
        control_freq_hz=args.control_freq,
        articulation_root_prim=args.articulation_root,
    )


def cmd_status(args: argparse.Namespace) -> None:
    data = _ok_or_exit(_send("status"))
    if args.json:
        _emit(args, data)
        return
    pos = data["pos_deg"]
    vel = data["vel_rad_s"]
    trq = data["torque_nm"]
    joint_names = ["J1", "J2", "J3", "J4", "J5", "J6"]
    print(f"{'Joint':<6}  {'pos(deg)':>9}  {'vel(rad/s)':>10}  {'torque(Nm)':>10}")
    print("-" * 42)
    for i, name in enumerate(joint_names):
        print(f"{name:<6}  {pos[i]:>9.2f}  {vel[i]:>10.3f}  {trq[i]:>10.3f}")
    if "gripper" in data:
        gval = data["gripper"]
        gstr = f"{gval:.3f}" if gval is not None else "N/A"
        print(f"\nGripper: {gstr}  (0.0=closed, 1.0=open)")


def cmd_move(args: argparse.Namespace) -> None:
    req_args: dict = {"speed": args.speed}
    if args.preset:
        req_args["preset"] = args.preset
    elif args.joints:
        try:
            vals = [float(v) for v in args.joints.split(",")]
        except ValueError:
            print("[a1zctl] joints must be 6 comma-separated numbers, e.g. 0,60,-60,0,0,0")
            sys.exit(1)
        if len(vals) != 6:
            print("[a1zctl] joints must have exactly 6 values")
            sys.exit(1)
        req_args["joints"] = vals
    else:
        print("[a1zctl] move requires --preset or a joints string, e.g.:  move 0,60,-60,0,0,0")
        sys.exit(1)

    data = _ok_or_exit(_send("move", req_args))
    if args.json:
        _emit(args, data)
        return
    print("[a1zctl] Moving...")
    pos = data.get("pos_deg", [])
    if pos:
        print(f"[a1zctl] Arrived: {[round(v, 1) for v in pos]}")


def cmd_command(args: argparse.Namespace) -> None:
    try:
        vals = [float(v) for v in args.joints.split(",")]
    except ValueError:
        print("[a1zctl] joints must be 6 comma-separated numbers, e.g. 0,60,-60,0,0,0")
        sys.exit(1)
    if len(vals) != 6:
        print("[a1zctl] joints must have exactly 6 values")
        sys.exit(1)

    req_args: dict = {"joints": vals}
    if args.gripper is not None:
        req_args["gripper"] = args.gripper

    data = _ok_or_exit(_send("command", req_args))
    if args.json:
        _emit(args, data)
        return
    target = data.get("target_deg", vals)
    print(f"[a1zctl] Target set: {[round(v, 1) for v in target]}")
    if "gripper" in data:
        print(f"[a1zctl] Gripper target: {data['gripper']:.2f}")


def cmd_gripper(args: argparse.Namespace) -> None:
    data = _ok_or_exit(_send("gripper", {"value": args.value}))
    if args.json:
        _emit(args, data)
        return
    print(f"[a1zctl] Gripper set to {data['gripper']:.2f}")


def cmd_grasp_attach(args: argparse.Namespace) -> None:
    req_args = {
        "target_prim_path": args.target_prim_path,
        "timeout_s": args.timeout_s,
        "contact_window_s": args.contact_window_s,
        "require_bilateral_contact": not args.allow_single_finger_contact,
    }
    data = _ok_or_exit(_send("grasp_attach", req_args))
    if args.json:
        _emit(args, data)
        return
    print(f"[a1zctl] grasp_attach success={bool(data.get('success', False))}")
    if data.get("failure_reason"):
        print(f"[a1zctl] failure_reason: {data['failure_reason']}")
    attached_object_path = data.get("attached_object_path")
    if attached_object_path:
        print(f"[a1zctl] attached_object_path: {attached_object_path}")
    attachment_joint_path = data.get("attachment_joint_path")
    if attachment_joint_path:
        print(f"[a1zctl] attachment_joint_path: {attachment_joint_path}")


def cmd_grasp_link(args: argparse.Namespace) -> None:
    req_args = {
        "target_prim_path": args.target_prim_path,
        "require_bilateral_contact": not args.allow_single_finger_contact,
    }
    data = _ok_or_exit(_send("grasp_link", req_args))
    if args.json:
        _emit(args, data)
        return
    print(f"[a1zctl] grasp_link success={bool(data.get('success', False))}")
    if data.get("failure_reason"):
        print(f"[a1zctl] failure_reason: {data['failure_reason']}")
    attached_object_path = data.get("attached_object_path")
    if attached_object_path:
        print(f"[a1zctl] attached_object_path: {attached_object_path}")
    attachment_joint_path = data.get("attachment_joint_path")
    if attachment_joint_path:
        print(f"[a1zctl] attachment_joint_path: {attachment_joint_path}")


def cmd_grasp_release(args: argparse.Namespace) -> None:
    data = _ok_or_exit(
        _send(
            "grasp_release",
            {
                "open_gripper": not args.keep_gripper_closed,
                "timeout_s": args.timeout_s,
            },
        )
    )
    if args.json:
        _emit(args, data)
        return
    print(f"[a1zctl] grasp_release success={bool(data.get('success', False))}")
    print(f"[a1zctl] released={bool(data.get('released', False))}")


def cmd_dance(args: argparse.Namespace) -> None:
    req_args: dict = {"speed": args.speed}
    if args.moves:
        req_args["moves"] = [m.strip() for m in args.moves.split(",") if m.strip()]
    data = _ok_or_exit(_send("dance", req_args))
    if args.json:
        _emit(args, data)
        return
    print("[a1zctl] Running dance sequence...")
    print(f"[a1zctl] Dance complete: {', '.join(data['moves'])}")


def cmd_stop(args: argparse.Namespace) -> None:
    data = _ok_or_exit(_send("stop"))
    if args.json:
        _emit(args, data)
        return
    print(f"[a1zctl] {data.get('message', 'Done.')}")


def cmd_info(args: argparse.Namespace) -> None:
    data = _ok_or_exit(_send("info"))
    if args.json:
        _emit(args, data)
        return
    print("Backend:     ", data.get("backend", "socketcan"))
    if "articulation_root_prim" in data:
        print("Articulation:", data["articulation_root_prim"])
    if "dof_names" in data:
        print("DOF names:   ", ", ".join(data["dof_names"]))
    print("Presets:     ", ", ".join(data["presets"]))
    print("Dance moves: ", ", ".join(data["dance_moves"]))
    print("Joint limits (degrees, software command):")
    for joint, (lo, hi) in data["joint_limits_deg"].items():
        print(f"  {joint}: [{lo}, {hi}]")
    if "hard_joint_limits_deg" in data:
        print("Hard limits (degrees, simulation/physical):")
        for joint, (lo, hi) in data["hard_joint_limits_deg"].items():
            print(f"  {joint}: [{lo}, {hi}]")
    if "arm_max_velocity_rad_s" in data:
        print("Max velocity (rad/s):")
        for idx, value in enumerate(data["arm_max_velocity_rad_s"], start=1):
            print(f"  J{idx}: {value}")
    if "gripper_range" in data:
        print(f"Gripper:     normalized {data['gripper_range']}")


# ---------------------------------------------------------------------------
# Argument parser
# ---------------------------------------------------------------------------

def build_parser() -> argparse.ArgumentParser:
    p = argparse.ArgumentParser(
        prog="a1zctl",
        description="A1Z robot arm CLI — controls a running a1zctl serve daemon.",
        formatter_class=argparse.RawDescriptionHelpFormatter,
        epilog="""
Examples:
  python3 tools/a1zctl serve --with-gripper
  python3 tools/a1zctl serve --backend mock --with-gripper
  python3 tools/a1zctl serve --backend isaacsim --with-gripper --control-freq 60
  python3 tools/a1zctl status
  python3 tools/a1zctl move 0,60,-60,0,0,0
  python3 tools/a1zctl command 0,60,-60,0,0,0 --gripper 0.5
  python3 tools/a1zctl move --preset home
  python3 tools/a1zctl gripper 0.5
  python3 tools/a1zctl grasp-attach --target-prim-path /World/TrashSet/mock_target
  python3 tools/a1zctl grasp-release
  python3 tools/a1zctl dance --moves salute,wave,bow --speed 0.7
  python3 tools/a1zctl stop
        """,
    )
    p.add_argument("--json", action="store_true", help="Print command result as JSON")
    sub = p.add_subparsers(dest="command", required=True)

    # serve
    sp = sub.add_parser("serve", help="Start the robot server (blocking)")
    default_backend = get_default_backend()
    default_can = get_default_can_channel()
    sp.add_argument(
        "--backend",
        default=default_backend,
        choices=["socketcan", "mock", "isaacsim"],
        help=f"Control backend (default: {default_backend})",
    )
    sp.add_argument("--can", default=default_can, help=f"SocketCAN channel (default: {default_can})")
    sp.add_argument(
        "--socket-path",
        default=get_socket_path(),
        help=f"Unix socket path (default: {get_socket_path()})",
    )
    sp.add_argument(
        "--tcp-host",
        default=get_tcp_host(),
        help=f"Optional TCP bind host for cross-container clients (default: {get_tcp_host()})",
    )
    sp.add_argument(
        "--tcp-port",
        type=int,
        default=get_tcp_port(),
        help=f"Optional TCP bind port for cross-container clients; set <=0 to disable (default: {get_tcp_port()})",
    )
    sp.add_argument("--with-gripper", action="store_true", help="Enable gripper motor")
    sp.add_argument(
        "--gravity-mode",
        action="store_true",
        help="Experimental zero-gravity effort mode; Isaac Sim position hold remains the stable default",
    )
    sp.add_argument(
        "--control-freq",
        type=int,
        default=250,
        help="Backend control/update frequency in Hz (default: 250; use 60 for Isaac)",
    )
    sp.add_argument(
        "--articulation-root",
        default=None,
        help="Isaac articulation root prim, used only with --backend isaacsim",
    )

    # status
    sub.add_parser("status", help="Print current joint positions, velocities, torques")

    # move
    mp = sub.add_parser(
        "move",
        help="Move to joint angles or a named preset",
        description=(
            "Move to absolute joint angles (degrees) or a named preset.\n\n"
            "  a1zctl move 0,60,-60,0,0,0\n"
            "  a1zctl move --preset home"
        ),
    )
    mp.add_argument("joints", nargs="?", default=None,
                    help="6 joint angles in degrees, comma-separated (e.g. 0,60,-60,0,0,0)")
    mp.add_argument("--preset", default=None,
                    help="Named preset: home | ready | salute | wave_l | wave_r | reach | bow ...")
    mp.add_argument("--speed", type=float, default=0.5, help="Movement speed rad/s (default: 0.5)")

    cp = sub.add_parser("command", help="Send an immediate joint target without waiting for motion completion")
    cp.add_argument("joints", help="6 joint angles in degrees, comma-separated (e.g. 0,60,-60,0,0,0)")
    cp.add_argument("--gripper", type=float, default=None, help="Optional gripper target in [0.0, 1.0]")

    # gripper
    gp = sub.add_parser("gripper", help="Set gripper opening (0.0=closed, 1.0=open)")
    gp.add_argument("value", type=float, help="Opening in [0.0, 1.0]")

    gap = sub.add_parser(
        "grasp-attach",
        help="Close the gripper, detect contact, and create a simulated attachment",
    )
    gap.add_argument(
        "--target-prim-path",
        default="",
        help="Optional target prim path to prefer during contact selection",
    )
    gap.add_argument(
        "--timeout-s",
        type=float,
        default=2.0,
        help="Soft-close timeout in seconds before the search-close fallback (default: 2.0)",
    )
    gap.add_argument(
        "--contact-window-s",
        type=float,
        default=0.15,
        help="Contact aggregation window in seconds (default: 0.15)",
    )
    gap.add_argument(
        "--allow-single-finger-contact",
        action="store_true",
        help="Allow attachment without bilateral finger contact",
    )

    glp = sub.add_parser(
        "grasp-link",
        help="Create a simulated attachment from the current contact state without moving the gripper",
    )
    glp.add_argument(
        "--target-prim-path",
        default="",
        help="Optional target prim path to prefer during contact selection",
    )
    glp.add_argument(
        "--allow-single-finger-contact",
        action="store_true",
        help="Allow attachment without bilateral finger contact",
    )

    grp = sub.add_parser("grasp-release", help="Release a simulated attachment")
    grp.add_argument(
        "--keep-gripper-closed",
        action="store_true",
        help="Detach without commanding the gripper back open",
    )
    grp.add_argument(
        "--timeout-s",
        type=float,
        default=2.0,
        help="Release timeout in seconds (default: 2.0)",
    )

    # dance
    dp = sub.add_parser("dance", help="Run a dance sequence")
    dp.add_argument("--moves", default=None,
                    help="Comma-separated move names (default: salute,wave,nod,reach,bow)")
    dp.add_argument("--speed", type=float, default=0.6, help="Base speed rad/s (default: 0.6)")

    # stop
    sub.add_parser("stop", help="Stop the robot server gracefully")

    # info
    sub.add_parser("info", help="List available presets, dance moves, and joint limits")

    return p


_COMMANDS = {
    "serve":   cmd_serve,
    "status":  cmd_status,
    "move":    cmd_move,
    "command": cmd_command,
    "gripper": cmd_gripper,
    "grasp-attach": cmd_grasp_attach,
    "grasp-link": cmd_grasp_link,
    "grasp-release": cmd_grasp_release,
    "dance":   cmd_dance,
    "stop":    cmd_stop,
    "info":    cmd_info,
}


def main() -> None:
    parser = build_parser()
    args = parser.parse_args()
    _COMMANDS[args.command](args)


if __name__ == "__main__":
    main()
