#!/usr/bin/env python3
"""Control a simulated or physical A1Z through one backend-neutral protocol."""

from __future__ import annotations

import argparse
import json
import os
import sys

REPO_ROOT = os.path.join(os.path.dirname(os.path.abspath(__file__)), "..")
SDK_ROOT = os.path.join(REPO_ROOT, "vendor", "GALAXEA-A1Z")
sys.path[:0] = [REPO_ROOT, SDK_ROOT]

from a1z_ext.config import (  # noqa: E402
    get_arm_motion_speed_limits,
    get_control_frequency_hz,
    get_default_backend,
    get_default_can_channel,
    get_gripper_max_torque_nm,
    get_gripper_empty_close_threshold,
    get_min_control_frequency_hz,
    get_socket_path,
    get_tcp_host,
    get_tcp_port,
    validate_arm_motion_speed,
)
from a1z_ext.control_client import send_control_request  # noqa: E402


def _send(command: str, payload: dict | None = None) -> dict:
    return send_control_request(
        command,
        payload,
        socket_path=get_socket_path(),
        tcp_host=get_tcp_host(),
        tcp_port=get_tcp_port(),
        timeout_s=120.0,
    )


def _emit(args: argparse.Namespace, data: dict) -> None:
    if args.json:
        print(json.dumps(data, ensure_ascii=False))
    else:
        print(json.dumps(data, ensure_ascii=False, indent=2))


def cmd_serve(args: argparse.Namespace) -> None:
    from a1z_ext.robots.server import serve

    serve(
        backend=args.backend,
        can_channel=args.can,
        with_gripper=args.with_gripper,
        gravity_mode=args.gravity_mode,
        gravity_comp_factor=args.gravity_factor,
        socket_path=args.socket_path,
        tcp_host=args.tcp_host,
        tcp_port=args.tcp_port,
        control_freq_hz=args.control_freq,
        min_freq_hz=args.min_control_freq,
        gripper_max_torque=args.gripper_max_torque,
        gripper_empty_close_threshold=args.gripper_empty_close_threshold,
        articulation_root_prim=args.articulation_root,
    )


def cmd_status(args: argparse.Namespace) -> None:
    _emit(args, _send("status"))


def cmd_info(args: argparse.Namespace) -> None:
    _emit(args, _send("info"))


def cmd_move(args: argparse.Namespace) -> None:
    payload: dict = {"speed": args.speed}
    if args.preset:
        payload["preset"] = args.preset
    elif args.joints:
        values = [float(value) for value in args.joints.split(",")]
        if len(values) != 6:
            raise ValueError("joints must contain 6 comma-separated degree values")
        payload["joints"] = values
    else:
        raise ValueError("move requires joints or --preset")
    _emit(args, _send("move", payload))


def cmd_command(args: argparse.Namespace) -> None:
    values = [float(value) for value in args.joints.split(",")]
    if len(values) != 6:
        raise ValueError("joints must contain 6 comma-separated degree values")
    payload: dict = {"joints": values}
    if args.gripper is not None:
        payload["gripper"] = args.gripper
    _emit(args, _send("command", payload))


def cmd_gripper(args: argparse.Namespace) -> None:
    _emit(args, _send("gripper", {"value": args.value}))


def cmd_grasp_close(args: argparse.Namespace) -> None:
    _emit(args, _send("grasp_close", {"timeout_s": args.timeout_s}))


def cmd_grasp_status(args: argparse.Namespace) -> None:
    _emit(args, _send("grasp_status"))


def cmd_grasp_release(args: argparse.Namespace) -> None:
    _emit(args, _send("grasp_release", {"timeout_s": args.timeout_s}))


def cmd_estop(args: argparse.Namespace) -> None:
    _emit(args, _send("estop"))


def cmd_estop_release(args: argparse.Namespace) -> None:
    _emit(args, _send("estop_release"))


def cmd_gravity_factor(args: argparse.Namespace) -> None:
    _emit(args, _send("gravity_factor", {"factor": args.factor}))


def cmd_stop(args: argparse.Namespace) -> None:
    _emit(args, _send("stop"))


def build_parser() -> argparse.ArgumentParser:
    parser = argparse.ArgumentParser(description=__doc__)
    parser.add_argument("--json", action="store_true")
    sub = parser.add_subparsers(dest="command", required=True)

    serve_parser = sub.add_parser("serve", help="Start the control server")
    serve_parser.add_argument(
        "--backend",
        choices=["socketcan", "mock", "isaacsim"],
        default=get_default_backend(),
    )
    serve_parser.add_argument("--can", default=get_default_can_channel())
    serve_parser.add_argument("--socket-path", default=get_socket_path())
    serve_parser.add_argument("--tcp-host", default=get_tcp_host())
    serve_parser.add_argument("--tcp-port", type=int, default=get_tcp_port())
    serve_parser.add_argument(
        "--with-gripper",
        action=argparse.BooleanOptionalAction,
        default=os.environ.get("A1Z_WITH_GRIPPER", "0") == "1",
    )
    serve_parser.add_argument("--gravity-mode", action="store_true")
    serve_parser.add_argument(
        "--gravity-factor",
        type=float,
        default=float(os.environ.get("A1Z_GRAVITY_COMP_FACTOR", "1.0")),
        help="Gravity compensation scale: 0=off, 1=full.",
    )
    serve_parser.add_argument(
        "--control-freq", type=int, default=get_control_frequency_hz()
    )
    serve_parser.add_argument(
        "--min-control-freq", type=float, default=get_min_control_frequency_hz()
    )
    serve_parser.add_argument(
        "--gripper-max-torque", type=float, default=get_gripper_max_torque_nm()
    )
    serve_parser.add_argument(
        "--gripper-empty-close-threshold",
        type=float,
        default=get_gripper_empty_close_threshold(),
    )
    serve_parser.add_argument("--articulation-root", default=None)

    sub.add_parser("status", help="Read joint state")
    sub.add_parser("info", help="Read backend capabilities")

    move_parser = sub.add_parser("move", help="Move to six joint angles in degrees")
    move_parser.add_argument("joints", nargs="?")
    move_parser.add_argument("--preset")
    speed_limits = get_arm_motion_speed_limits()
    move_parser.add_argument(
        "--speed",
        type=validate_arm_motion_speed,
        default=speed_limits.default,
    )

    command_parser = sub.add_parser("command", help="Send a joint target")
    command_parser.add_argument("joints")
    command_parser.add_argument("--gripper", type=float)

    gripper_parser = sub.add_parser("gripper", help="Set opening: 0 closed, 1 open")
    gripper_parser.add_argument("value", type=float)

    close_parser = sub.add_parser("grasp-close", help="Close and verify object capture")
    close_parser.add_argument("--timeout-s", type=float, default=15.0)
    sub.add_parser("grasp-status", help="Read common grasp state")
    release_parser = sub.add_parser("grasp-release", help="Open the gripper")
    release_parser.add_argument("--timeout-s", type=float, default=3.0)
    sub.add_parser("estop", help="Latch the physical SDK soft emergency stop")
    sub.add_parser("estop-release", help="Release the physical SDK estop latch")
    gravity_factor_parser = sub.add_parser(
        "gravity-factor", help="Set gravity compensation scale"
    )
    gravity_factor_parser.add_argument("factor", type=float)
    sub.add_parser("stop", help="Stop the server")
    return parser


COMMANDS = {
    "serve": cmd_serve,
    "status": cmd_status,
    "info": cmd_info,
    "move": cmd_move,
    "command": cmd_command,
    "gripper": cmd_gripper,
    "grasp-close": cmd_grasp_close,
    "grasp-status": cmd_grasp_status,
    "grasp-release": cmd_grasp_release,
    "estop": cmd_estop,
    "estop-release": cmd_estop_release,
    "gravity-factor": cmd_gravity_factor,
    "stop": cmd_stop,
}


def main() -> None:
    args = build_parser().parse_args()
    try:
        COMMANDS[args.command](args)
    except Exception as exc:
        if args.json:
            print(json.dumps({"error": str(exc)}, ensure_ascii=False))
        else:
            print(f"a1zctl: {exc}", file=sys.stderr)
        raise SystemExit(1) from exc


if __name__ == "__main__":
    main()
