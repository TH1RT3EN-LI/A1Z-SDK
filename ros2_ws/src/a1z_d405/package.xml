<?xml version="1.0"?>
<package format="3">
  <name>a1z_d405</name>
  <version>0.1.0</version>
  <description>ROS 2 D405 bridge for A1Z Isaac-backed and real robot RGB-D streams.</description>

  <maintainer email="devnull@example.com">A1Z</maintainer>
  <license>MIT</license>

  <buildtool_depend>ament_python</buildtool_depend>

  <depend>rclpy</depend>
  <depend>sensor_msgs</depend>
  <depend>std_msgs</depend>
  <depend>geometry_msgs</depend>
  <depend>tf2_ros</depend>

  <export>
    <build_type>ament_python</build_type>
  </export>
</package>
