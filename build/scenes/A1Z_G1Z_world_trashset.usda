            bool physics:rigidBodyEnabled = 1
            float physxRigidBody:angularDamping = 0.4
            float physxRigidBody:contactSlopCoefficient = 0
            bool physxRigidBody:enableCCD = 1
            float physxRigidBody:linearDamping = 0.8
            float physxRigidBody:maxContactImpulse = 8
            float physxRigidBody:maxDepenetrationVelocity = 0.5
            int physxRigidBody:solverPositionIterationCount = 64
            int physxRigidBody:solverVelocityIterationCount = 16
            float xformOp:rotateZ = 18
            float3 xformOp:scale = (1, 1, 1)
            double3 xformOp:translate = (0.42, -0.06, 0.035899998339265604)
            uniform token[] xformOpOrder = ["xformOp:translate", "xformOp:rotateZ", "xformOp:scale"]

            over "_03_cracker_box" (
                prepend apiSchemas = ["PhysicsCollisionAPI", "PhysicsMeshCollisionAPI", "PhysxCollisionAPI", "MaterialBindingAPI"]
            )
            {
                rel material:binding:physics = </World/Looks/TrashSetMaterials/Physics/paper_physics> (
                    bindMaterialAs = "weakerThanDescendants"
                )
                uniform token physics:approximation = "convexHull"
                bool physics:collisionEnabled = 1
                float physxCollision:contactOffset = 0.002
                float physxCollision:restOffset = 0.001
            }
        }

        def Xform "bottle_water" (
            prepend apiSchemas = ["PhysicsRigidBodyAPI", "PhysicsMassAPI", "PhysxRigidBodyAPI"]
            prepend references = @../../assets/trash_grasp_set/isaac_ycb/Axis_Aligned/004_sugar_box.usd@
        )
        {
            float physics:mass = 0.016
            bool physics:rigidBodyEnabled = 1
            float physxRigidBody:angularDamping = 0.4
            float physxRigidBody:contactSlopCoefficient = 0
            bool physxRigidBody:enableCCD = 1
            float physxRigidBody:linearDamping = 0.8
            float physxRigidBody:maxContactImpulse = 8
            float physxRigidBody:maxDepenetrationVelocity = 0.5
            int physxRigidBody:solverPositionIterationCount = 64
            int physxRigidBody:solverVelocityIterationCount = 16
            float xformOp:rotateZ = -10
            float3 xformOp:scale = (1, 1, 1)
            double3 xformOp:translate = (0.3, 0.12, 0.022567469569277687)
            uniform token[] xformOpOrder = ["xformOp:translate", "xformOp:rotateZ", "xformOp:scale"]

            over "_04_sugar_box" (
                prepend apiSchemas = ["PhysicsCollisionAPI", "PhysicsMeshCollisionAPI", "PhysxCollisionAPI", "MaterialBindingAPI"]
            )
            {
                rel material:binding:physics = </World/Looks/TrashSetMaterials/Physics/paper_physics> (
                    bindMaterialAs = "weakerThanDescendants"
                )
                uniform token physics:approximation = "convexHull"
                bool physics:collisionEnabled = 1
                float physxCollision:contactOffset = 0.002
                float physxCollision:restOffset = 0.001
