#usda 1.0

over "World"
{
    over "Looks"
    {
        def Scope "TrashSetMaterials"
        {
        }
    }

    over "GroundPlane" (
        prepend apiSchemas = ["PhysicsCollisionAPI", "PhysxCollisionAPI"]
    )
    {
        float physxCollision:contactOffset = 0
        float physxCollision:restOffset = 0
    }

    def Xform "TrashSet"
    {
        def Xform "can_crushed" (
            prepend apiSchemas = ["PhysicsRigidBodyAPI", "PhysicsMassAPI"]
            prepend references = @https://omniverse-content-production.s3-us-west-2.amazonaws.com/Assets/Isaac/5.1/Isaac/Props/YCB/Axis_Aligned/008_pudding_box.usd@
        )
        {
            float physics:mass = 0.009
            bool physics:rigidBodyEnabled = 1
            float xformOp:rotateZ = 28
            float3 xformOp:scale = (1, 1, 1)
            double3 xformOp:translate = (0.3, 0, 0)
            uniform token[] xformOpOrder = ["xformOp:translate", "xformOp:rotateZ", "xformOp:scale"]

            over "_08_pudding_box" (
                prepend apiSchemas = ["PhysicsCollisionAPI", "PhysicsMeshCollisionAPI", "PhysxCollisionAPI"]
            )
            {
                uniform token physics:approximation = "convexHull"
                float physxCollision:contactOffset = 0
                float physxCollision:restOffset = 0
            }
        }

        def Xform "can_upright" (
            prepend apiSchemas = ["PhysicsRigidBodyAPI", "PhysicsMassAPI"]
            prepend references = @https://omniverse-content-production.s3-us-west-2.amazonaws.com/Assets/Isaac/5.1/Isaac/Props/YCB/Axis_Aligned/040_large_marker.usd@
        )
        {
            float physics:mass = 0.012
            bool physics:rigidBodyEnabled = 1
            float xformOp:rotateZ = 0
            float3 xformOp:scale = (1, 1, 1)
            double3 xformOp:translate = (0.3, -0.12, 0)
            uniform token[] xformOpOrder = ["xformOp:translate", "xformOp:rotateZ", "xformOp:scale"]

            over "_40_large_marker" (
                prepend apiSchemas = ["PhysicsCollisionAPI", "PhysicsMeshCollisionAPI", "PhysxCollisionAPI"]
            )
            {
                uniform token physics:approximation = "convexHull"
                float physxCollision:contactOffset = 0
                float physxCollision:restOffset = 0
            }
        }

        def Xform "bottle_plastic" (
            prepend apiSchemas = ["PhysicsRigidBodyAPI", "PhysicsMassAPI"]
            prepend references = @https://omniverse-content-production.s3-us-west-2.amazonaws.com/Assets/Isaac/5.1/Isaac/Props/YCB/Axis_Aligned/003_cracker_box.usd@
        )
        {
            float physics:mass = 0.018
            bool physics:rigidBodyEnabled = 1
            float xformOp:rotateZ = 18
            float3 xformOp:scale = (1, 1, 1)
            double3 xformOp:translate = (0.42, -0.06, 0)
            uniform token[] xformOpOrder = ["xformOp:translate", "xformOp:rotateZ", "xformOp:scale"]

            over "_03_cracker_box" (
                prepend apiSchemas = ["PhysicsCollisionAPI", "PhysicsMeshCollisionAPI", "PhysxCollisionAPI"]
            )
            {
                uniform token physics:approximation = "convexHull"
                float physxCollision:contactOffset = 0
                float physxCollision:restOffset = 0
            }
        }

        def Xform "bottle_water" (
            prepend apiSchemas = ["PhysicsRigidBodyAPI", "PhysicsMassAPI"]
            prepend references = @https://omniverse-content-production.s3-us-west-2.amazonaws.com/Assets/Isaac/5.1/Isaac/Props/YCB/Axis_Aligned/004_sugar_box.usd@
        )
        {
            float physics:mass = 0.016
            bool physics:rigidBodyEnabled = 1
            float xformOp:rotateZ = -10
            float3 xformOp:scale = (1, 1, 1)
            double3 xformOp:translate = (0.3, 0.12, 0)
            uniform token[] xformOpOrder = ["xformOp:translate", "xformOp:rotateZ", "xformOp:scale"]

            over "_04_sugar_box" (
                prepend apiSchemas = ["PhysicsCollisionAPI", "PhysicsMeshCollisionAPI", "PhysxCollisionAPI"]
            )
            {
                uniform token physics:approximation = "convexHull"
                float physxCollision:contactOffset = 0
                float physxCollision:restOffset = 0
            }
        }

        def Xform "paper_debris" (
            prepend apiSchemas = ["PhysicsRigidBodyAPI", "PhysicsMassAPI"]
            prepend references = @https://omniverse-content-production.s3-us-west-2.amazonaws.com/Assets/Isaac/5.1/Isaac/Props/YCB/Axis_Aligned/009_gelatin_box.usd@
        )
        {
            float physics:mass = 0.01
            bool physics:rigidBodyEnabled = 1
            float xformOp:rotateZ = -32
            float3 xformOp:scale = (1, 1, 1)
            double3 xformOp:translate = (0.42, 0.08, 0)
            uniform token[] xformOpOrder = ["xformOp:translate", "xformOp:rotateZ", "xformOp:scale"]

            over "_09_gelatin_box" (
                prepend apiSchemas = ["PhysicsCollisionAPI", "PhysicsMeshCollisionAPI", "PhysxCollisionAPI"]
            )
            {
                uniform token physics:approximation = "convexHull"
                float physxCollision:contactOffset = 0
                float physxCollision:restOffset = 0
            }
        }
    }
}

