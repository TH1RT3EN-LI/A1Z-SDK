#usda 1.0

over "World"
{
    over "Looks"
    {
        def Scope "TrashSetMaterials"
        {
            def Scope "Physics"
            {
                def Material "can_physics" (
                    prepend apiSchemas = ["PhysicsMaterialAPI", "PhysxMaterialAPI"]
                )
                {
                    float physics:dynamicFriction = 0.95
                    float physics:restitution = 0
                    float physics:staticFriction = 1.25
                    bool physxMaterial:compliantContactAccelerationSpring = 0
                    float physxMaterial:compliantContactDamping = 0
                    float physxMaterial:compliantContactStiffness = 0
                    uniform token physxMaterial:dampingCombineMode = "average"
                    uniform token physxMaterial:frictionCombineMode = "min"
                    uniform token physxMaterial:restitutionCombineMode = "min"
                }

                def Material "paper_physics" (
                    prepend apiSchemas = ["PhysicsMaterialAPI", "PhysxMaterialAPI"]
                )
                {
                    float physics:dynamicFriction = 0.95
                    float physics:restitution = 0
                    float physics:staticFriction = 1.25
                    bool physxMaterial:compliantContactAccelerationSpring = 0
                    float physxMaterial:compliantContactDamping = 0
                    float physxMaterial:compliantContactStiffness = 0
                    uniform token physxMaterial:dampingCombineMode = "average"
                    uniform token physxMaterial:frictionCombineMode = "min"
                    uniform token physxMaterial:restitutionCombineMode = "min"
                }

                def Material "plastic_bottle_physics" (
                    prepend apiSchemas = ["PhysicsMaterialAPI", "PhysxMaterialAPI"]
                )
                {
                    float physics:dynamicFriction = 0.95
                    float physics:restitution = 0
                    float physics:staticFriction = 1.25
                    bool physxMaterial:compliantContactAccelerationSpring = 0
                    float physxMaterial:compliantContactDamping = 0
                    float physxMaterial:compliantContactStiffness = 0
                    uniform token physxMaterial:dampingCombineMode = "average"
                    uniform token physxMaterial:frictionCombineMode = "min"
                    uniform token physxMaterial:restitutionCombineMode = "min"
                }

                def Material "tool_physics" (
                    prepend apiSchemas = ["PhysicsMaterialAPI", "PhysxMaterialAPI"]
                )
                {
                    float physics:dynamicFriction = 0.95
                    float physics:restitution = 0
                    float physics:staticFriction = 1.25
                    bool physxMaterial:compliantContactAccelerationSpring = 0
                    float physxMaterial:compliantContactDamping = 0
                    float physxMaterial:compliantContactStiffness = 0
                    uniform token physxMaterial:dampingCombineMode = "average"
                    uniform token physxMaterial:frictionCombineMode = "min"
                    uniform token physxMaterial:restitutionCombineMode = "min"
                }

                def Material "default_physics" (
                    prepend apiSchemas = ["PhysicsMaterialAPI", "PhysxMaterialAPI"]
                )
                {
                    float physics:dynamicFriction = 0.95
                    float physics:restitution = 0
                    float physics:staticFriction = 1.25
                    bool physxMaterial:compliantContactAccelerationSpring = 0
                    float physxMaterial:compliantContactDamping = 0
                    float physxMaterial:compliantContactStiffness = 0
                    uniform token physxMaterial:dampingCombineMode = "average"
                    uniform token physxMaterial:frictionCombineMode = "min"
                    uniform token physxMaterial:restitutionCombineMode = "min"
                }
            }
        }
    }

    over "GroundPlane" (
        prepend apiSchemas = ["PhysicsCollisionAPI", "PhysxCollisionAPI"]
    )
    {
        float physxCollision:contactOffset = 0.002
        float physxCollision:restOffset = 0.001
    }

    def Xform "TrashSet"
    {
        def Xform "can_crushed" (
            prepend apiSchemas = ["PhysicsRigidBodyAPI", "PhysicsMassAPI", "PhysxRigidBodyAPI"]
            prepend references = @../../assets/trash_grasp_set/isaac_ycb/Axis_Aligned/008_pudding_box.usd@
        )
        {
            float physics:mass = 0.009
            bool physics:rigidBodyEnabled = 1
            float physxRigidBody:angularDamping = 0.4
            float physxRigidBody:contactSlopCoefficient = 0
            bool physxRigidBody:enableCCD = 1
            float physxRigidBody:linearDamping = 0.8
            float physxRigidBody:maxContactImpulse = 8
            float physxRigidBody:maxDepenetrationVelocity = 0.5
            int physxRigidBody:solverPositionIterationCount = 64
            int physxRigidBody:solverVelocityIterationCount = 16
            float xformOp:rotateZ = 28
            float3 xformOp:scale = (1, 1, 1)
            double3 xformOp:translate = (0.3, 0, 0.019235260056661208)
            uniform token[] xformOpOrder = ["xformOp:translate", "xformOp:rotateZ", "xformOp:scale"]

            over "_08_pudding_box" (
                prepend apiSchemas = ["PhysicsCollisionAPI", "PhysicsMeshCollisionAPI", "PhysxCollisionAPI", "MaterialBindingAPI"]
            )
            {
                rel material:binding:physics = </World/Looks/TrashSetMaterials/Physics/paper_physics> (
                    bindMaterialAs = "weakerThanDescendants"
                )
                uniform token physics:approximation = "convexHull"
                bool physics:collisionEnabled = 1
                float physxCollision:contactOffset = 0.002
                float physxCollision:restOffset = 0.001
            }
        }

        def Xform "marker_upright" (
            prepend apiSchemas = ["PhysicsRigidBodyAPI", "PhysicsMassAPI", "PhysxRigidBodyAPI"]
            prepend references = @../../assets/trash_grasp_set/isaac_ycb/Axis_Aligned/040_large_marker.usd@
