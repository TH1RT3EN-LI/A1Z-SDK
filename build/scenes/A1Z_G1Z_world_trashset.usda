        }

        def Xform "paper_debris" (
            prepend apiSchemas = ["PhysicsRigidBodyAPI", "PhysicsMassAPI", "PhysxRigidBodyAPI"]
            prepend references = @../../assets/trash_grasp_set/isaac_ycb/Axis_Aligned/009_gelatin_box.usd@
        )
        {
